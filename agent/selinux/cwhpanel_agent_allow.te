	type data_home_t;
	type config_home_t;
# [free] removed (spamassassin policy type absent): 	type spamc_home_t;
	type proc_net_t;
# [free] removed (spamassassin policy type absent): 	type spamd_unit_file_t;
	type cwhpanel_worker_port_t;
	type http_port_t;
	type mail_spool_t;
	type dovecot_var_run_t;
	type lastlog_t;
	type devpts_t;
	type default_t;
	type shell_exec_t;
