# Application
# production by default: never ship a debug-mode panel. Local dev
# installs may switch to local/true.
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8081
# Encryption key for DB-backed session payloads. MUST be a random string
# (install.sh / turn-up.sh generate one). Empty disables secure session
# encryption and Session::sessionKey() throws in production.
APP_KEY=
# Panel self-update repository (GitHub). Accepts "owner/repo" or a full clone
# URL; Server → Updates checks this repo for new releases.
PANEL_UPSTREAM_REPO=https://github.com/cheap-web-hosting/cwhpanel.git

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cwhpanel
DB_USERNAME=cwhpanel
DB_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
# auto = Secure cookie whenever APP_URL is https (TLS deployments);
# explicit true/false overrides (false for plain-http dev servers).
SESSION_SECURE_COOKIE=auto
SESSION_DOMAIN=

# Provisioning (privileged agent). See /agent.
PROVISIONING_ENABLED=false
PROVISIONING_SOCKET=/run/cwhpanel/agent.sock
PROVISIONING_TIMEOUT=600

# ACME / Let's Encrypt
# staging (safe default): https://acme-staging-v02.api.letsencrypt.org/directory
# production:            https://acme-v02.api.letsencrypt.org/directory
ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_EMAIL=

# Demo/test content (demo customer + starter package + demo account).
# 0 = a production install starts clean; 1 = create demo data (CI/e2e).
SEED_DEMO=0

# Seed credentials (admin is always created; demo customer only with SEED_DEMO=1)

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=

# Webmail single sign-on (Dovecot master-user auth). Generated automatically;
# lets the panel open a customer mailbox without knowing its password.
MAIL_MASTER_PASSWORD=

# Domain auto-provisioning (DNS zone + A record target).
# Use documentation ranges (RFC 5737 / example.com) — never real infra.
DNS_NAMESERVER=
PANEL_PUBLIC_IP=
DNS_NAMESERVER2=
# PREFIX for per-domain mail hostnames (mail.<domain>), not a full hostname.
# Set it to "mail." unless you really serve every domain's mail from one name.
MAIL_HOSTNAME=mail.
DKIM_SELECTOR=default

# PanelManager telemetry (optional; leave empty to disable). The reporter
# registers this installation and heartbeats hourly; the dashboard can ban
# the hostname (refuses future registration/reporting) and block updates
# (refuses update operations here until re-enabled there).
PANEL_MANAGER_URL=
# free | paid
PANEL_MANAGER_LICENSE_TYPE=free
PANEL_MANAGER_LICENSE_KEY=
