# Rotate the shared ModSecurity audit log.
#
# copytruncate (NOT create + a USR1 reopen): nginx's USR1 "reopen logs"
# signal does NOT cover ModSecurity's SecAuditLog file descriptor. After a
# create/rename rotation the module keeps writing to the rotated inode, so
# the active /var/log/nginx/modsec_audit stays empty and the panel's
# WAF "recent blocks" attribution silently returns nothing until the next
# full nginx restart. copytruncate preserves the inode (the open FD stays
# valid) and truncates in place, so writes keep landing in the active file.
/var/log/nginx/modsec_audit {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
}