# cwhpanel — fleet backup plan scheduler (all accounts).
# Every 10 minutes; the script itself checks enabled + next_run_at and is
# idempotent (one pending plan job at a time).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/10 * * * * root /usr/bin/php __PANEL_DIR__/scripts/backup-plan-scheduler.php >/dev/null 2>&1